name: xiaosu_core
description: 小酥 - 全功能 AI 助手
publish_to: 'none'
version: 2.0.0+20

environment:
  sdk: '>=3.0.0 <4.0.0'
  flutter: '>=3.10.0'

dependencies:
  flutter:
    sdk: flutter
  cupertino_icons: ^1.0.6
  
  # Routing
  go_router: ^14.0.0
  
  # State management
  flutter_riverpod: ^2.4.9
  riverpod_annotation: ^2.3.3
  
  # Network
  dio: ^5.4.0
  http: ^1.1.0
  web_socket_channel: ^2.4.0
  
  # Database
  # drift: ^2.18.0  # 暂不使用，避免native编译问题
  
  # Storage
  shared_preferences: ^2.2.2
  path_provider: ^2.1.1
  hive: ^2.2.3
  hive_flutter: ^1.1.0
  flutter_secure_storage: ^9.0.0
  
  # AI/LLM
  openai_dart: ^0.4.0
  
  # Tools
  uuid: ^4.2.1
  crypto: ^3.0.3
  encrypt: ^5.0.3
  archive: ^3.6.0
  collection: ^1.18.0
  equatable: ^2.0.5
  json_annotation: ^4.8.1
  intl: ^0.19.0
  url_launcher: ^6.2.2
  share_plus: ^7.2.1
  file_picker: ^6.1.1
  logger: ^2.0.2+1
  
  # UI
  flutter_markdown: ^0.7.0
  cached_network_image: ^3.3.0
  flutter_animate: ^4.3.0
  google_fonts: ^6.1.0
  flutter_svg: ^2.0.9
  
  # Platform
  connectivity_plus: ^5.0.2
  local_auth: ^2.1.8
  permission_handler: ^11.1.0
  device_info_plus: ^10.0.0
  battery_plus: ^3.0.3
  package_info_plus: ^8.0.0
  
  # Multimedia
#  image_picker: ^1.0.4
  video_player: ^2.8.0
  audioplayers: ^5.2.1
#  camera: ^0.11.0+2
  
  # Notifications
  flutter_local_notifications: ^17.0.0
  flutter_timezone: ^3.0.0

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^3.0.0
  build_runner: ^2.4.7
  json_serializable: ^6.7.1
  riverpod_generator: ^2.3.9

flutter:
  uses-material-design: true
  
  assets:
    - assets/
    - assets/icons/
    - assets/images/
    - assets/models/
    - assets/templates/
    - assets/fonts/
  
  fonts:
    - family: XiaosuIcon
      fonts:
        - asset: assets/fonts/XiaosuIcon.ttf
